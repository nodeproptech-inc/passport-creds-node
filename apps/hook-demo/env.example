# ComplianceHook demo — configuration template
# Rename to .env.example (repo convention) or copy straight to .env and fill in.
# Every value is optional for local anvil: with no .env at all, the demo runs
# fully local on anvil dev accounts.

# ── Chain ────────────────────────────────────────────────────────────────────
# Local (default):  http://127.0.0.1:8545
# Ethereum Sepolia: your RPC endpoint (Alchemy/Infura/dRPC…)
#RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Block explorer base URL — when set, tx hashes in the demo link out to it
# (the built-in tx inspector works either way).
#EXPLORER_URL=https://sepolia.etherscan.io

# ── Actors (funded private keys; anvil dev keys used when unset) ─────────────
# operator = contract admin + simulated CRE + LP: pays all deploys, needs the most ETH
#OPERATOR_PK=0x...
#ANA_PK=0x...
#RUI_PK=0x...

# ── Deploy (read by contracts/script/DeployHookDemo.s.sol) ───────────────────
# Canonical v4 PoolManager on the target chain — skips deploying a local one.
# Ethereum Sepolia: 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
#POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# ── Server ───────────────────────────────────────────────────────────────────
#PORT=4180
#ADDRESSES_FILE=addresses.json

# Sepolia flow:
#   1. fill RPC_URL, EXPLORER_URL, OPERATOR_PK/ANA_PK/RUI_PK (funded), POOL_MANAGER
#   2. cd contracts && set -a && source ../apps/hook-demo/.env && set +a && \
#      forge script script/DeployHookDemo.s.sol --rpc-url $RPC_URL --broadcast
#   3. cd apps/hook-demo && npm start
# Notes: timewarp + reset are local-only; expiry demos need real time on testnets.
