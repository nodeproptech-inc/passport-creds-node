# House Concierge demo — configuration template
# Copy to .env and fill in. Every value is optional for local anvil: with no
# .env at all, the demo runs fully local on anvil dev accounts with the
# deterministic mock decider.

# ── Chain ────────────────────────────────────────────────────────────────────
# Local (default):  http://127.0.0.1:8545
# Ethereum Sepolia: your RPC endpoint (Alchemy/Infura/dRPC…)
#RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Block explorer base URL — when set, tx hashes in the demo link out to it
# (the built-in tx inspector works either way).
#EXPLORER_URL=https://sepolia.etherscan.io

# ── Actors (funded private keys; anvil dev keys used when unset) ─────────────
# operator = house owner #1, contract admin + simulated CRE + LP: pays all deploys
# ana      = house owner #2, second signature on above-cap payments
# concierge= the agent's hot key (holds the CASA budget — keep it small)
# plumber  = the x402 vendor's payout wallet
#OPERATOR_PK=0x...
#ANA_PK=0x...
#CONCIERGE_PK=0x...
#PLUMBER_PK=0x...

# ── Deploy (read by contracts/script/DeployConciergeDemo.s.sol) ──────────────
# Canonical v4 PoolManager on the target chain — skips deploying a local one.
# Ethereum Sepolia: 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
#POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# ── Decision engine ─────────────────────────────────────────────────────────
# mock   — deterministic rules (default, no network, always demo-safe)
# openai — any OpenAI-compatible /chat/completions endpoint; falls back to mock
# zerog  — 0G decentralized inference (wired at the event)
DECIDER=mock
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_API_KEY=sk-...
#ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
#ZEROG_PROVIDER=0x...
#ZEROG_PRIVATE_KEY=0x...

# ── Server ───────────────────────────────────────────────────────────────────
#PORT=4190
#PORT_VENDOR=4191
#ADDRESSES_FILE=addresses.json
# Interface both servers bind to. Default 127.0.0.1 (loopback only).
# ⚠ Widening this (e.g. 0.0.0.0) exposes unauthenticated spend routes — anyone
# who can reach the port can move the funded keys' money.
#BIND_HOST=127.0.0.1

# Sepolia flow:
#   1. fill RPC_URL, EXPLORER_URL, OPERATOR_PK/ANA_PK/CONCIERGE_PK/PLUMBER_PK (funded), POOL_MANAGER
#   2. cd contracts && set -a && source ../apps/concierge/.env && set +a && \
#      forge script script/DeployConciergeDemo.s.sol --rpc-url $RPC_URL --broadcast
#   3. cd apps/concierge && npm start
# Notes: timewarp + reset are local-only; mandate-expiry demos need real time on testnets.
