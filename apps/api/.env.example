# =============================================================
# PassportKit Node — Backend (NestJS)
# Chain: Ethereum Sepolia (L1) — ENS + Uniswap v4 co-located here
# Copy to .env and fill. NEVER commit real secrets (.env is gitignored).
# =============================================================

# --- Core ---
DATABASE_URL=postgresql://passport:passport@localhost:5432/passportkit
PORT=3005
CORS_ORIGIN=http://localhost:3003
# Shared secret inbound webhooks must include (X-Webhook-Secret header)
WEBHOOK_SECRET=change-me
# true = mock contract adapter + simulated tx hashes (demo fallback)
DEMO_MODE=true
# Tenant / branding label shown in responses
TENANT_ID=passportkit-demo

# --- Network (Ethereum Sepolia) ---
RPC_URL=https://sepolia.infura.io/v3/<your-key>
CHAIN_ID=11155111

# --- Backend keys ---
# EIP-712 issuer signer: signs claims OFF-CHAIN (no gas). Its ADDRESS is
# authorized in ClaimIssuer.isAuthorizedSigner. NEVER commit the real value.
ISSUER_SIGNER_PRIVATE_KEY=0x
# Agent key: sends on-chain txs (createIdentity, setRevoked) — needs gas.
# Can be the same key as the signer for the MVP.
AGENT_PRIVATE_KEY=0x

# --- PassportKit contracts (fill after deploy → keep README address table in sync) ---
IDENTITY_FACTORY_ADDRESS=0x
CLAIM_ISSUER_ADDRESS=0x
ISSUER_REGISTRY_ADDRESS=0x
ELIGIBILITY_GATE_ADDRESS=0x
GATED_ERC20_ADDRESS=0x
PASSPORT_RESOLVER_ADDRESS=0x
SUBNAME_REGISTRAR_ADDRESS=0x
# Reused soulbound badge (points to identity)
COMPLIANCE_PASSPORT_ADDRESS=0x

# --- Policies (EligibilityGate policyIds) ---
POLICY_DEAL_ROOM=1   # KYC only
POLICY_INVESTOR=2    # KYC + accredited

# --- World ID (personhood + attributes) ---
# Verify exact keys at the World booth (Identity Attestations + Selfie Check betas)
WORLD_APP_ID=app_
WORLD_ACTION=passportkit-verify
# Required by IDKit Request Widget. Keep this server-only; never expose the signing key to Next.js.
WORLD_RP_ID=rp_
WORLD_RP_SIGNING_KEY=0x
WORLD_IDENTITY_ATTESTATIONS_KEY=
WORLD_SELFIE_CHECK_KEY=

# --- Privy (embedded wallet / JWT verification) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- ENS (Ethereum Sepolia) ---
ENS_PARENT_NAME=passportkit.eth
# Sepolia NameWrapper (ENS official deployment — reference only, no deploy)
ENS_NAMEWRAPPER_ADDRESS=0x0635513f179D50A207757E05759CbD106d7dFcE8

# --- Chainlink CRE (in scope; exact role in the new design TBD) ---
CRE_BASE_URL=http://localhost:3002
CRE_UPDATER_PRIVATE_KEY=0x

# --- Legacy PassportCreds (being replaced — kept during transition) ---
# CLAIM_REGISTRY_ADDRESS=0x
# ACCESS_GATE_ADDRESS=0x
