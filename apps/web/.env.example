# =============================================================
# PassportKit Node — Frontend (Next.js)
# Chain: Ethereum Sepolia (L1)
# =============================================================

NEXT_PUBLIC_API_URL=http://localhost:3001

# Privy App ID (console.privy.io) — set = embedded wallet primary; blank = MetaMask only
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Network (Ethereum Sepolia) ---
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# --- PassportKit contracts (fill after deploy) ---
NEXT_PUBLIC_ELIGIBILITY_GATE_ADDRESS=0x
NEXT_PUBLIC_IDENTITY_FACTORY_ADDRESS=0x
NEXT_PUBLIC_GATED_ERC20_ADDRESS=0x
NEXT_PUBLIC_COMPLIANCE_PASSPORT_ADDRESS=0x

# --- ENS ---
NEXT_PUBLIC_ENS_PARENT_NAME=passportkit.eth

# --- World ID (widget) ---
NEXT_PUBLIC_WORLD_APP_ID=app_
NEXT_PUBLIC_WORLD_ACTION=passportkit-verify
