# =============================================================
# PassportKit Node — Contracts (Foundry)
# Deploy target: Ethereum Sepolia (L1)
# =============================================================

# Deployer wallet (funds the deploy). Include the 0x prefix.
DEPLOYER_PRIVATE_KEY=0x

# --- Network (Ethereum Sepolia) ---
RPC_URL=https://sepolia.infura.io/v3/<your-key>
CHAIN_ID=11155111
# For `forge verify-contract`
ETHERSCAN_API_KEY=

# --- Roles wired at deploy ---
# Address authorized in ClaimIssuer.isAuthorizedSigner (the backend signer)
ISSUER_SIGNER_ADDRESS=0x
# Address granted AGENT_ROLE (createIdentity, setRevoked)
AGENT_ADDRESS=0x

# --- ENS (Ethereum Sepolia) ---
ENS_PARENT_NAME=passportkit.eth
# Sepolia NameWrapper (ENS official deployment — reference only, no deploy)
ENS_NAMEWRAPPER_ADDRESS=0x0635513f179D50A207757E05759CbD106d7dFcE8
# namehash(passportkit.eth) — derive in the script or paste
ENS_PARENT_NODE=0x

# --- Uniswap v4 (Ethereum Sepolia) — for ComplianceHook ---
# PoolManager — verify at the Uniswap booth / v4 deployments
UNIV4_POOL_MANAGER=0x
